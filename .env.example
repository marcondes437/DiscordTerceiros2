# Supabase / Lovable Cloud
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Login com Google: ative o provedor Google no Supabase e troque para true
VITE_GOOGLE_LOGIN=false

# TURN para chamadas em redes restritas (escolha UMA opção)
# A) TURN próprio
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
# B) Metered.ca
VITE_METERED_DOMAIN=
VITE_METERED_API_KEY=

# Jogos da comunidade — preencher quando os sites estiverem publicados
VITE_RABISCO_URL=
VITE_SLITHERSENAI_URL=

# Opcional: busca online de GIFs. Sem chave, usa a coleção inicial.
VITE_GIPHY_API_KEY=
